<mxfile host="app.diagrams.net">
  <diagram id="validacion" name="Validacion Larman">
    <mxGraphModel dx="1100" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t1" value="&lt;b&gt;Tabla 1 · UC ↔ SSD&lt;/b&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th&gt;Paso del UC&lt;/th&gt;&lt;th&gt;Mensaje SSD&lt;/th&gt;&lt;th&gt;¿Existe?&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1. Conductor inserta ticket&lt;/td&gt;&lt;td&gt;insertarTicket(codigo)&lt;/td&gt;&lt;td&gt;✅&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2. Sistema calcula monto&lt;/td&gt;&lt;td&gt;interno (en el retorno de 1)&lt;/td&gt;&lt;td&gt;✅&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3. Sistema muestra monto&lt;/td&gt;&lt;td&gt;retorno monto: Dinero&lt;/td&gt;&lt;td&gt;✅&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4. Conductor elige medio&lt;/td&gt;&lt;td&gt;pagar(medio)&lt;/td&gt;&lt;td&gt;✅&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5. Sistema procesa pago&lt;/td&gt;&lt;td&gt;autorizarCobro / ingresarEfectivo&lt;/td&gt;&lt;td&gt;✅&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6. Marca pagado + comprobante&lt;/td&gt;&lt;td&gt;retorno comprobante: Comprobante&lt;/td&gt;&lt;td&gt;✅&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;7. Conductor pasa barrera&lt;/td&gt;&lt;td&gt;validarSalida(codigo)&lt;/td&gt;&lt;td&gt;✅&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;8. Barrera valida y se abre&lt;/td&gt;&lt;td&gt;abrir() / rechazar()&lt;/td&gt;&lt;td&gt;✅&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="520" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="t2" value="&lt;b&gt;Tabla 2 · UC ↔ Dominio&lt;/b&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th&gt;Sustantivo del UC&lt;/th&gt;&lt;th&gt;¿Clase?&lt;/th&gt;&lt;th&gt;Si falta, ¿qué es?&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Ticket&lt;/td&gt;&lt;td&gt;✅&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Tarifa&lt;/td&gt;&lt;td&gt;✅&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Pago&lt;/td&gt;&lt;td&gt;✅&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Comprobante&lt;/td&gt;&lt;td&gt;✅&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Plaza&lt;/td&gt;&lt;td&gt;✅&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Conductor&lt;/td&gt;&lt;td&gt;❌&lt;/td&gt;&lt;td&gt;actor, no se guardan sus datos&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Barrera&lt;/td&gt;&lt;td&gt;❌&lt;/td&gt;&lt;td&gt;actor (dispositivo externo)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Caja de pago&lt;/td&gt;&lt;td&gt;❌&lt;/td&gt;&lt;td&gt;interfaz del sistema&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Pasarela&lt;/td&gt;&lt;td&gt;❌&lt;/td&gt;&lt;td&gt;actor secundario&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="560" y="20" width="520" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="t3" value="&lt;b&gt;Tabla 3 · SSD ↔ Dominio&lt;/b&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th&gt;Operación / parámetro / retorno&lt;/th&gt;&lt;th&gt;Tipo&lt;/th&gt;&lt;th&gt;¿En dominio?&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;insertarTicket(codigo: String)&lt;/td&gt;&lt;td&gt;String&lt;/td&gt;&lt;td&gt;✅ (primitivo; atributo codigo)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;retorno monto: Dinero&lt;/td&gt;&lt;td&gt;Dinero&lt;/td&gt;&lt;td&gt;❌ (primitivo) D-05&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;pagar(medio: MedioPago)&lt;/td&gt;&lt;td&gt;MedioPago&lt;/td&gt;&lt;td&gt;❌ D-03&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;retorno comprobante&lt;/td&gt;&lt;td&gt;Comprobante&lt;/td&gt;&lt;td&gt;✅&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;autorizarCobro → autorizacion&lt;/td&gt;&lt;td&gt;Autorizacion&lt;/td&gt;&lt;td&gt;❌ D-04&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ingresarEfectivo(importe)&lt;/td&gt;&lt;td&gt;Dinero&lt;/td&gt;&lt;td&gt;❌ (primitivo) D-05&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;retorno vuelto&lt;/td&gt;&lt;td&gt;Dinero&lt;/td&gt;&lt;td&gt;✅ (atributo vuelto de PagoEfectivo)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="20" y="300" width="520" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="t4" value="&lt;b&gt;Tabla 4 · SSD ↔ Estados&lt;/b&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th&gt;Operación SSD&lt;/th&gt;&lt;th&gt;Estado destino&lt;/th&gt;&lt;th&gt;¿Transición?&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;pagar()&lt;/td&gt;&lt;td&gt;Pagado&lt;/td&gt;&lt;td&gt;✅&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;validarSalida() (abrir)&lt;/td&gt;&lt;td&gt;Salido&lt;/td&gt;&lt;td&gt;✅ (se llama pasarBarrera) D-02&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;(timeout) after(20 min)&lt;/td&gt;&lt;td&gt;Vencido&lt;/td&gt;&lt;td&gt;✅&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;validarSalida() (rechazar)&lt;/td&gt;&lt;td&gt;sin cambio&lt;/td&gt;&lt;td&gt;✅ (no cambia el estado)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;pagarCargoAdicional()&lt;/td&gt;&lt;td&gt;Pagado&lt;/td&gt;&lt;td&gt;❌ falta en el SSD D-01&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;anular()&lt;/td&gt;&lt;td&gt;Anulado&lt;/td&gt;&lt;td&gt;❌ falta en el SSD D-06&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="560" y="300" width="520" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="t5" value="&lt;b&gt;Lista de defectos detectados&lt;/b&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th&gt;#&lt;/th&gt;&lt;th&gt;Sev.&lt;/th&gt;&lt;th&gt;Defecto&lt;/th&gt;&lt;th&gt;Vistas&lt;/th&gt;&lt;th&gt;Acción de corrección&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D-01&lt;/td&gt;&lt;td&gt;🔴&lt;/td&gt;&lt;td&gt;Vencido → Pagado (pagarCargoAdicional) no tiene operación en el SSD&lt;/td&gt;&lt;td&gt;SSD, Estados&lt;/td&gt;&lt;td&gt;Agregar al SSD un alt para ticket vencido: insertarTicket devuelve el cargo adicional y pagar() lo cobra&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D-02&lt;/td&gt;&lt;td&gt;🟡&lt;/td&gt;&lt;td&gt;Mismo evento con dos nombres: validarSalida (SSD) y pasarBarrera (Estados)&lt;/td&gt;&lt;td&gt;SSD, Estados&lt;/td&gt;&lt;td&gt;Unificar el nombre en las dos vistas&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D-03&lt;/td&gt;&lt;td&gt;🟡&lt;/td&gt;&lt;td&gt;MedioPago se usa en el SSD pero no existe en el dominio&lt;/td&gt;&lt;td&gt;SSD, Dominio&lt;/td&gt;&lt;td&gt;Agregar MedioPago (tarjeta, efectivo) al dominio o relacionarlo con la generalización de Pago&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D-04&lt;/td&gt;&lt;td&gt;🟡&lt;/td&gt;&lt;td&gt;Autorizacion se usa en el SSD pero no existe en el dominio&lt;/td&gt;&lt;td&gt;SSD, Dominio&lt;/td&gt;&lt;td&gt;Cambiar el retorno a aprobado: Boolean, o modelarla como dato de PagoTarjeta&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D-05&lt;/td&gt;&lt;td&gt;🔵&lt;/td&gt;&lt;td&gt;Dinero es un tipo primitivo, no una clase del dominio&lt;/td&gt;&lt;td&gt;SSD, Dominio&lt;/td&gt;&lt;td&gt;Declararlo como tipo de valor en una nota del modelo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D-06&lt;/td&gt;&lt;td&gt;🔵&lt;/td&gt;&lt;td&gt;anular() está en Estados pero ningún UC la dispara&lt;/td&gt;&lt;td&gt;Estados, SSD&lt;/td&gt;&lt;td&gt;Documentarla como otro caso de uso (anular ticket)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D-07&lt;/td&gt;&lt;td&gt;🟡&lt;/td&gt;&lt;td&gt;Tarjeta rechazada no aparece ni en el SSD ni en Estados&lt;/td&gt;&lt;td&gt;SSD, Estados&lt;/td&gt;&lt;td&gt;Agregar la rama de rechazo en el alt y una auto-transición en Emitido&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="20" y="580" width="1060" height="380" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
